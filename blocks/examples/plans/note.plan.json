{
  "type": "Plan",
  "name": "note_with_count",
  "version": "0.1.0",
  "description": "Count the words of a text and save it as a note.",
  "variables": {"name": {"type": "string"}, "text": {"type": "string"}},
  "steps": [
    {"id": "count", "block": "word_count", "inputs": {"text": "$input.text"}},
    {"id": "save", "block": "write_note", "inputs": {"name": "$input.name", "text": "$input.text"}}
  ],
  "answer": "Saved {save.path} ({count.words} words).",
  "trigger": {"pattern": "(?is)^save a note called (?P<name>[\\w-]+): (?P<text>.+)$"}
}
