#!/bin/sh
# Morphogen's command, run inside the substrate-tools container from repos/morphogen (S-19). Commands that
# start sandboxed runs (judge, tune, measure) need a container engine of their own: run those through the
# Morphogen plugin in Claude Code, which runs on the host.
root=$(cd "$(dirname "$0")/.." && pwd)
exec "$root/bin/in-tools" uv run --quiet --project "$root/repos/morphogen" morphogen "$@"
