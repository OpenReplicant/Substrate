#!/bin/sh
# Run a command inside the substrate-tools container (S-19). The other files in bin/ call this; Claude Code
# calls them for kernel's MCP server and hooks, so it stays small and fast (no .env parsing beyond one line).
#
#   bin/in-tools COMMAND [ARGS...]
root=$(cd "$(dirname "$0")/.." && pwd)
engine=${CONTAINER_ENGINE:-$(sed -n 's/^CONTAINER_ENGINE=//p' "$root/.env" 2>/dev/null | tail -1)}
engine=${engine:-podman}

if [ "$($engine inspect -f '{{.State.Running}}' substrate-tools 2>/dev/null)" != "true" ]; then
  echo "substrate-tools is not running: $root/scripts/tools.sh start" >&2
  exit 1
fi

flags="-i"; [ -t 0 ] && [ -t 1 ] && flags="-it"
# the working folder, when the container can see it (this checkout or a connected project)
workdir=$root
case "$PWD" in "$root"|"$root"/*) workdir=$PWD ;; esac
grep -qx "$PWD" "$root/.state/projects" 2>/dev/null && workdir=$PWD
# what kernel's commands and Claude Code pass through the environment
envs=""
for v in KK_LOGIN_FILE KK_PROFILE KK_ADMIN_URL KK_JWT_SECRET KK_ROLE KK_DATABASE_URL DATABASE_URL \
         CLAUDE_PROJECT_DIR CLAUDE_SESSION_ID; do
  eval "isset=\${$v+x}"; [ -n "$isset" ] && envs="$envs -e $v"
done
# shellcheck disable=SC2086
exec "$engine" exec $flags $envs -w "$workdir" substrate-tools "$@"
