# Substrate's stack: one file for every service. scripts/up.sh copies this to .env and generates the missing
# secrets once, into the secrets slot (S-31). Never commit .env. Comments go on their own lines.

# What runs the services: compose (Linux and macOS) or nomad (Linux; the chosen control plane, S-16, S-17)
RUNTIME=compose
# docker or podman: compose's engine, or Nomad's task driver (S-13)
CONTAINER_ENGINE=podman

# ---- secrets (S-31): where the settings listed in deploy/secrets.txt live
#   env      in this file (default)
#   openbao  in OpenBao on 127.0.0.1:8200, started by scripts/secrets.sh; this file keeps them empty
#            (scripts/secrets.sh migrate moves them out of here)
SECRETS=env
OPENBAO_IMAGE=docker.io/openbao/openbao:2.7.1

# ---- Nomad (RUNTIME=nomad; scripts/bootstrap.sh installs the Podman driver when needed)
NOMAD_ADDR=http://127.0.0.1:4646
NOMAD_VERSION=2.0.7
NOMAD_DRIVER_PODMAN_VERSION=0.6.5

# ---- kernel (as repos/kernel/deploy/.env.example)
POSTGRES_PASSWORD=
KK_AUTHENTICATOR_PASSWORD=
KK_JWT_SECRET=
# the Caddy release the front door starts from (kernel pins the same one)
CADDY_IMAGE=caddy:2.11.7-alpine
KK_SITE=
# Postgres on the host; change it if 5432 is taken
KK_DB_PORT=5432

# ---- substrate's additions to kernel's stack
# generated: the bus login (substrate_bus) for the `substrate` database
SUBSTRATE_BUS_PASSWORD=
# the front door: Caddy, with any plugins in deploy/caddy/plugins.txt (S-20); the console is at /console/ (S-22)
FRONT_DOOR_IMAGE=localhost/substrate-caddy:local

# what the kernel container runs (kk serve --only); empty: kernel's default plus observer and drift (S-33)
KK_SERVE_PARTS=

# ---- model gateway (S-04, S-14)
BIFROST_IMAGE=docker.io/maximhq/bifrost:v2.3.2
BIFROST_PORT=8090
# generated: Claude Code and kernel modules send it to the gateway
BIFROST_VIRTUAL_KEY=
BIFROST_ADMIN_PASSWORD=
# optional: leave empty to use your Claude subscription through the gateway
ANTHROPIC_API_KEY=
# optional: OpenRouter models (openrouter/...) through the gateway
OPENROUTER_API_KEY=
# a local model server on this machine (Ollama); false to leave it out
OLLAMA_ENABLED=true
# empty: found automatically for the runtime and engine (scripts/render_bifrost.py)
OLLAMA_URL=

# ---- telemetry (S-05)
PROMETHEUS_IMAGE=quay.io/prometheus/prometheus:v3.15.0@sha256:efd719c99d83b060d9daefdcf00360461adf279f45ef5391f8d111892118753e
PROMETHEUS_PORT=9090

# ---- OpenTelemetry (S-28): the collector; Claude Code sends here once scripts/telemetry.py on has run
OTEL_COLLECTOR_IMAGE=docker.io/otel/opentelemetry-collector-contrib:0.163.2
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

# ---- map (S-12)
BACKSTAGE_IMAGE=localhost/substrate-backstage:local
BACKSTAGE_PORT=7007
# generated: Claude Code's bearer token for Backstage's MCP endpoint
BACKSTAGE_MCP_TOKEN=
