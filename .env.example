# Substrate's settings, one file. scripts/up.sh copies this to .env (mode 600) and generates the missing
# secrets once (deploy/secrets.txt). Never commit .env. Comments go on their own lines.

# What runs the services. compose is the one runtime (S-41); scripts call only scripts/runtime/<name>.sh's
# rt_* verbs, so another can be added beside it.
RUNTIME=compose
# podman (tested) or docker
CONTAINER_ENGINE=podman
# Where the secrets in deploy/secrets.txt live. env (this file) is the one backend; scripts read them only
# through env_value and sec_*, so a store can sit behind the same calls later.
SECRETS=env

# ---- Postgres (deploy/postgres: Postgres 17 with pgvector, pg_cron, pgmq, pgGraph)
POSTGRES_PASSWORD=
# Postgres on the host; change it if 5432 is taken
DB_PORT=5432
# the volume its data lives in; a second instance on one machine needs its own
DB_VOLUME=substrate_db-data

# ---- models (S-75, S-77)
# OpenRouter's API key; empty: no OpenRouter
OPENROUTER_API_KEY=
# Ollama for local models, as the gateway reaches it: the stack's own is http://ollama:11434; empty: none
OLLAMA_URL=http://ollama:11434
# the local model server (Ollama, S-83); its models live in this volume
OLLAMA_IMAGE=docker.io/ollama/ollama:0.40.12
OLLAMA_VOLUME=substrate_ollama-models
# the local model server on the host, for pulling models; change it if 11434 is taken
OLLAMA_PORT=11434
# a GPU for the local model server: nvidia (deploy/compose.nvidia.yaml: the device nodes and the driver's libraries,
# from NVIDIA_LIB_DIR, default /usr/lib/x86_64-linux-gnu); empty: the CPU (S-84)
OLLAMA_GPU=
NVIDIA_LIB_DIR=
# the store's embedding model (S-83), its name at the gateway
STORE_EMBED_MODEL=ollama/qwen3-embedding:0.6b
STORE_EMBED_KEY=
# the model gateway (Bifrost, S-77): every model call goes through it and is counted there
GATEWAY_IMAGE=docker.io/maximhq/bifrost:v2.3.2
# the gateway on the host; change it if 8090 is taken
GATEWAY_PORT=8090
# the UI (S-140) on the host; change it if 8100 is taken
UI_PORT=8100

# ---- the Knowledge Kernel (S-153, S-154): the store, in its own database `kernel` in this Postgres
# where the UI reads entities, pages and maps from: kernel (default) or store (the old schema, until it is retired)
STORE_BACKEND=kernel
# the kernel's database as the UI reaches it; empty: the `kernel` database in this Postgres, as the kernel's
# login kk_authenticator (its password is generated below), switched to the read model's role
KERNEL_URL=
# the kernel's secrets, generated once (deploy/secrets.txt)
KK_AUTHENTICATOR_PASSWORD=
KK_JWT_SECRET=
# OpenRouter models a caller may use (comma-separated names or regex:...); empty: free ones only
GATEWAY_OPENROUTER_MODELS=
# calls each caller may make in an hour; empty: no cap of the gateway's own
GATEWAY_REQUESTS_PER_HOUR=
GATEWAY_DB_PASSWORD=
GATEWAY_METER_PASSWORD=
GATEWAY_ADMIN_PASSWORD=
GATEWAY_KEY_SECRET=

# ---- the companion (plan step 4, S-136): Claude Code on the owner's own Claude login, through the gateway
# Anthropic models its keys may reach (comma-separated names or regex:...); empty: Haiku only
COMPANION_MODELS=
# the session's model, until an approved proposal changes it
COMPANION_MODEL=claude-haiku-5-5
# minutes between clock ticks (each also carries the meter); every tick is a turn for the session
COMPANION_CLOCK_MINUTES=60
# the daily token budget the companion starts with (its own proposals change it, once the owner approves)
COMPANION_DAILY_TOKENS=2000000
# the person who decides its proposals, as the record names them
OWNER_NAME=owner
COMPANION_SESSION_KEY=
COMPANION_TASK_KEY=
COMPANION_DB_PASSWORD=

# ---- the local model (plan step 5): llama.cpp's server on the GPU, behind the gateway as provider `local`
# the folder holding GGUF files (mounted read-only) and the file to serve; empty LLM_MODEL: no local model
LLM_MODELS_DIR=
LLM_MODEL=
# its name at the gateway (local/<LLM_ALIAS>)
LLM_ALIAS=gemma
# llama-server's options: all layers on the GPU, MoE experts in system RAM, 16k context, 4-bit KV cache
LLM_ARGS=-ngl 999 --cpu-moe -c 16384 -ctk q4_0 -ctv q4_0 -fa auto
LLM_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda12-b12098

# ---- the voice head (plan step 5): the companion's voice and face, at 127.0.0.1:VOICE_PORT
VOICE_PORT=8110
# Kokoro's voice; the CPU threads for speech; seconds of silence that end an utterance
VOICE_STYLE=af_heart
VOICE_THREADS=4
VOICE_SILENCE_S=0.6
VOICE_KEY=
# the avatar (S-158, S-159): a .vrm, .glb or .gltf under .state/avatar/ (never committed), e.g. .state/avatar/pixar-girl/scene.gltf; empty: the canvas face
AVATAR_FILE=
# Kokoro on the GPU (compose service tts, S-150): http://tts:8880; empty: Kokoro on the CPU in the voice head
TTS_URL=
COMPANION_AUTHOR_KEY=
JUDGE_KEY=
JUDGE_DB_PASSWORD=

# ---- the worker (plan step 1, S-163): an offline agent on the local model, compose service `worker` (profile llm)
# its key at the gateway (local models only) and its login to the store's database; its kernel login is made once with
# scripts/kernel.sh login worker (.state/kernel/worker.env)
WORKER_KEY=
# the worker's compiled skills (S-164): a folder of blocks and plans, e.g. blocks/examples; empty: none
WORKER_BLOCKS=
WORKER_DB_PASSWORD=
# the model it asks for at the gateway; steps a task may take; tokens of context it keeps (the model has 16k); empty: the model's own
# reasoning setting, or none | low | medium | high
WORKER_MODEL=local/gemma
WORKER_MAX_STEPS=8
WORKER_CONTEXT_TOKENS=11000
WORKER_REASONING=

# ---- published images (S-167): scripts/up.sh pulls ghcr.io/openreplicant/substrate-* and the kernel's image, and builds only what did not pull
# the tag of Substrate's images, and of the kernel's (main, a v-tag, or a short commit)
SUBSTRATE_IMAGE_TAG=main
KERNEL_IMAGE_TAG=main
# 1: build every image here instead of pulling (the voice head is always built here)
SUBSTRATE_BUILD=
