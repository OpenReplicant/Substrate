# Substrate's settings, one file. scripts/up.sh copies this to .env (mode 600) and generates the missing
# secrets once (deploy/secrets.txt). Never commit .env. Comments go on their own lines.

# What runs the services. compose is the one runtime (S-41); scripts call only scripts/runtime/<name>.sh's
# rt_* verbs, so another can be added beside it (catalog-info.yaml, system options).
RUNTIME=compose
# podman (tested) or docker
CONTAINER_ENGINE=podman
# Where the secrets in deploy/secrets.txt live. env (this file) is the one backend; scripts read them only
# through env_value and sec_*, so a store can sit behind the same calls later.
SECRETS=env

# ---- Postgres (deploy/postgres: Postgres 17 with pgvector, pg_cron, pgmq, pgGraph)
POSTGRES_PASSWORD=
# Postgres on the host; change it if 5432 is taken
DB_PORT=5432
# the volume its data lives in; a second instance on one machine needs its own
DB_VOLUME=substrate_db-data

# ---- the front door (Caddy at 127.0.0.1:8080)
CADDY_IMAGE=docker.io/library/caddy:2.11.7-alpine
# a public host name, for HTTPS (Caddy needs ports 80 and 443 published too); empty: local only
PUBLIC_HOST=
# origins (space-separated) whose web UIs Workbench may show as apps in a tab, beyond its own
WB_FRAME_SRC=

# ---- Workbench (workbench/BRIEF.md): its database, PostgREST at /api, its server at /wb/api
WORKBENCH_AUTHENTICATOR_PASSWORD=
WORKBENCH_JWT_SECRET=
WORKBENCH_SERVER_PASSWORD=
WORKBENCH_READER_PASSWORD=
POSTGREST_IMAGE=docker.io/postgrest/postgrest:v16.5
# the secrets-store option (scripts/secrets/openbao.sh); empty means the pinned default
OPENBAO_IMAGE=

# ---- models (spec section 10, step 18; S-75)
# OpenRouter's API key; the owner's is capped at $0.01, for free models only. Empty: no OpenRouter handlers
OPENROUTER_API_KEY=
# Ollama for local models (quantized GGUF from Hugging Face, picked by leaderboard), as the gateway reaches it
# (e.g. http://host.containers.internal:11434); empty: none
OLLAMA_URL=
# the local model server (Ollama, S-83); its models live in this volume
OLLAMA_IMAGE=docker.io/ollama/ollama:0.40.12
OLLAMA_VOLUME=substrate_ollama-models
# the local model server on the host, for pulling models; change it if 11434 is taken
OLLAMA_PORT=11434
# Workbench's embedding model for recall (S-83): its name at the gateway, and the instructions it wants
WORKBENCH_EMBED_MODEL=ollama/qwen3-embedding:0.6b
WORKBENCH_EMBED_QUERY_PREFIX="Instruct: Given a request or question about a software system, retrieve the parts of the system it concerns\nQuery: "
WORKBENCH_EMBED_DOC_PREFIX=
WORKBENCH_EMBED_KEY=
# the model gateway (Bifrost, S-77): every model call goes through it and is counted there
GATEWAY_IMAGE=docker.io/maximhq/bifrost:v2.3.2
# the gateway on the host; change it if 8090 is taken
GATEWAY_PORT=8090
# OpenRouter models a caller may use (comma-separated names or regex:...); empty: free ones only
GATEWAY_OPENROUTER_MODELS=
# calls each caller may make in an hour
GATEWAY_REQUESTS_PER_HOUR=120
GATEWAY_DB_PASSWORD=
GATEWAY_METER_PASSWORD=
GATEWAY_ADMIN_PASSWORD=
GATEWAY_KEY_SECRET=
