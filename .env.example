# Substrate's settings, one file. scripts/up.sh copies this to .env (mode 600) and generates the missing
# secrets once (deploy/secrets.txt). Never commit .env. Comments go on their own lines.

# What runs the services. compose is the one runtime (S-41); scripts call only scripts/runtime/<name>.sh's
# rt_* verbs, so another can be added beside it.
RUNTIME=compose
# podman (tested) or docker
CONTAINER_ENGINE=podman
# Where the secrets in deploy/secrets.txt live. env (this file) is the one backend; scripts read them only
# through env_value and sec_*, so a store can sit behind the same calls later.
SECRETS=env
# the compose project: its containers are named after it (PROJECT-db-1, ...). A second instance on one machine needs a
# name of its own here, its own TOOLS_CONTAINER, volumes (DB_VOLUME, OLLAMA_VOLUME, KERNEL_ARTIFACTS_VOLUME) and ports
COMPOSE_PROJECT_NAME=substrate
# the tools container (scripts/tools.sh), which bin/ runs commands in
TOOLS_CONTAINER=substrate-tools
# the optional services compose starts beside the core: llm (the local models); comma-separated, e.g. llm; empty:
# the core only
COMPOSE_PROFILES=

# ---- Postgres (deploy/postgres: Postgres 17 with pgvector, pg_cron, pgmq, pgGraph)
POSTGRES_PASSWORD=
# Postgres on the host; change it if 5432 is taken
DB_PORT=5432
# the volume its data lives in; a second instance on one machine needs its own
DB_VOLUME=substrate_db-data
# the kernel's artifact store (catalog files as they were read); a second instance needs its own
KERNEL_ARTIFACTS_VOLUME=substrate_kernel-artifacts

# ---- models (S-75, S-77)
# OpenRouter's API key; empty: no OpenRouter
OPENROUTER_API_KEY=
# Ollama for local models, as the gateway reaches it: the stack's own is http://ollama:11434; empty: none
OLLAMA_URL=http://ollama:11434
# the local model server (Ollama, S-83); its models live in this volume
OLLAMA_IMAGE=docker.io/ollama/ollama:0.40.12
OLLAMA_VOLUME=substrate_ollama-models
# the local model server on the host, for pulling models; change it if 11434 is taken
OLLAMA_PORT=11434
# a GPU for the local model server: nvidia (deploy/compose.nvidia.yaml: the device nodes and the driver's libraries,
# from NVIDIA_LIB_DIR, default /usr/lib/x86_64-linux-gnu); empty: the CPU (S-84)
OLLAMA_GPU=
NVIDIA_LIB_DIR=
# the store's embedding model (S-83), its name at the gateway
STORE_EMBED_MODEL=ollama/qwen3-embedding:0.6b
STORE_EMBED_KEY=
# the model gateway (Bifrost, S-77): every model call goes through it and is counted there
GATEWAY_IMAGE=docker.io/maximhq/bifrost:v2.3.2
# the gateway on the host; change it if 8090 is taken
GATEWAY_PORT=8090
# the UI (S-140) on the host; change it if 8100 is taken
UI_PORT=8100
# the desktop (Caddy, S-199) on the host; change it if 8080 is taken
DESKTOP_PORT=8080
# the desktop's framed apps on the host, each on an origin of its own (S-200): the gateway's dashboard, the map pages,
# the MCP router (its page, and its MCP endpoint at /mcp); change one if it is taken
DESKTOP_GATEWAY_PORT=8081
DESKTOP_MAPS_PORT=8082
DESKTOP_ROUTER_PORT=8083

# ---- the Knowledge Kernel (S-153, S-154): the store, in its own database `kernel` in this Postgres
# the kernel's database as the UI reaches it; empty: the `kernel` database in this Postgres, as the kernel's
# login kk_authenticator (its password is generated below), switched to the read model's role
KERNEL_URL=
# the kernel's secrets, generated once (deploy/secrets.txt)
KK_AUTHENTICATOR_PASSWORD=
# the MCP router's and its connectors' logins to the kernel's database (S-205)
MCP_ROUTER_DB_PASSWORD=
MCP_CONNECTOR_DB_PASSWORD=
MCP_DESKTOP_DB_PASSWORD=
KK_JWT_SECRET=
# OpenRouter models a caller may use (comma-separated names or regex:...); empty: free ones only
GATEWAY_OPENROUTER_MODELS=
# calls each caller may make in an hour; empty: no cap of the gateway's own
GATEWAY_REQUESTS_PER_HOUR=
GATEWAY_DB_PASSWORD=
GATEWAY_METER_PASSWORD=
GATEWAY_ADMIN_PASSWORD=
GATEWAY_KEY_SECRET=

# ---- Anthropic through the gateway: the models a caller on a Claude login may reach (comma-separated names or
# regex:...); empty: Haiku only. No caller has one since the old assistant retired (S-194).
ANTHROPIC_MODELS=

# ---- the local models (plan step 5, S-169): llama.cpp's server, behind the gateway. Two of them: a slow capable one on
# the CPU and in RAM (provider `local`), and a small fast one wholly on the GPU (provider `fast`) for what must answer at
# once; the GPU is left to the fast models (a slow model's GPU work slowed the fast one by a quarter, S-169)
# the folder holding GGUF files (mounted read-only) and the file to serve; empty LLM_MODEL: no slow model
LLM_MODELS_DIR=
LLM_MODEL=
# its name at the gateway (local/<LLM_ALIAS>)
LLM_ALIAS=slow
# llama-server's options: no layers on the GPU, 6 threads (memory bandwidth is the limit: 8 were no faster), 16k context,
# 4-bit KV cache; a machine with a free GPU may put layers there (-ngl 999 --cpu-moe, then -ot for experts)
LLM_ARGS=-ngl 0 --no-op-offload -t 6 -c 16384 -b 512 -ub 128 -ctk q4_0 -ctv q4_0 -fa on
# llama.cpp's server image, for both models (b12627: Inkling 2's architecture, inkling2_loop, arrived in b12591)
LLM_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda12-b12627
# the fast model: its folder and file (empty: none), its name at the gateway (fast/<LLM_FAST_ALIAS>), its options;
# recommended: LFM3 1.7B (Q6_K GGUF), downloaded by you, under Liquid AI's LFM Open License v1.0 (read it; S-169, S-188)
LLM_FAST_MODELS_DIR=
LLM_FAST_MODEL=
LLM_FAST_ALIAS=fast
LLM_FAST_ARGS=-ngl 999 -t 2 -c 32768 -fa on -ctk q8_0 -ctv q8_0

# ---- published images (S-167): scripts/up.sh pulls ghcr.io/openreplicant/substrate-* and the kernel's image, and builds only what did not pull
# the tag of Substrate's images, and of the kernel's: this release's and the kernel release it was tested with (VERSION);
# main follows the main branches (what a working checkout wants), a short commit pins one build
SUBSTRATE_IMAGE_TAG=0.1.0-preview.1
KERNEL_IMAGE_TAG=0.1.0
# 1: build every image here instead of pulling
SUBSTRATE_BUILD=
