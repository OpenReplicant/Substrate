# The map-diagram trial's browser: Playwright's image (Chromium and its system libraries) plus its Python package,
# every wheel pinned by hash (read from pypi.org 2026-11-17; each released at least two weeks before).
FROM mcr.microsoft.com/playwright/python:v1.64.1-noble@sha256:330d401ae23c905896a0c26c66c36fc971b621519e7b11b435a8328d7bf6e031
RUN printf '%s\n' \
  'playwright==1.64.1 --hash=sha256:577b8d88778c245cfbd145ae17cf53044f084b1b46c55c69081d4069d56057e2' \
  'pyee==14.0.0 --hash=sha256:3ac2d3229a9677f7de2c33d7f52fe25b638a46b19c413fea2edc8c6d0a644e4d' \
  'greenlet==3.5.6 --hash=sha256:975736b002ed080d124cf81a79cb7e05cb26d6b3f5c7a7b651c0fcce70353aa1' \
  'typing-extensions==4.15.0 --hash=sha256:f0fa19c6845758ab08074a0cfa8b7aecb71c999ca73d62883bc25cc018c4e548' \
  > /tmp/req.txt \
 && pip install --no-cache-dir --break-system-packages --require-hashes --only-binary=:all: -r /tmp/req.txt && rm /tmp/req.txt
