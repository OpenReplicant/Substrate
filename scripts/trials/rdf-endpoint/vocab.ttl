# A small vocabulary for the trial (spec step 4, docs/choices/rdf-endpoint.md): enough classes and properties to
# test whether a candidate reasons over subclasses and subproperties. Not Workbench's vocabulary; that comes
# with the vocabulary work (x-term on content types).
@prefix wb:   <https://workbench.local/ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

wb:Item      a owl:Class .
wb:Part      a owl:Class ; rdfs:subClassOf wb:Item .
wb:Component a owl:Class ; rdfs:subClassOf wb:Part .
wb:Skill     a owl:Class ; rdfs:subClassOf wb:Part .
wb:Hook      a owl:Class ; rdfs:subClassOf wb:Part .
wb:Claim     a owl:Class .

wb:relatedTo a owl:ObjectProperty .
wb:dependsOn a owl:ObjectProperty ; rdfs:subPropertyOf wb:relatedTo .
wb:partOf    a owl:ObjectProperty ; rdfs:subPropertyOf wb:relatedTo .
wb:about     a owl:ObjectProperty .

wb:slug      a owl:DatatypeProperty .
wb:field     a owl:DatatypeProperty .
wb:quote     a owl:DatatypeProperty .
wb:author    a owl:DatatypeProperty .
wb:sourceUri a owl:DatatypeProperty .
