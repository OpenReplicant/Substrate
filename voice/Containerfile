# substrate-voice (plan step 5, S-147): the voice head. The browser's microphone in, over a WebSocket; voice activity
# (Silero) and speech-to-text (Parakeet TDT 110M) on sherpa-onnx; replies from the local model through the gateway;
# text-to-speech (Kokoro v1.0 int8) on kokoro-onnx; the audio back to the browser, which draws the face.
# Both speech libraries carry espeak-ng (GPL-3.0), fetched here at build, unmodified, in this container (S-146).
#   scripts/build.sh voice
FROM docker.io/library/python:3.13.17-slim-bookworm
RUN pip install --no-cache-dir numpy==2.5.4 onnxruntime==1.31.1 sherpa-onnx==2.0.1 sherpa-onnx-core==2.0.1 \
      kokoro-onnx==0.6.1 websockets==17.3 "psycopg[binary]==3.3.6"
RUN useradd --uid 1000 --create-home --user-group speaker
USER speaker
WORKDIR /app
ENV PYTHONPATH=/app PYTHONDONTWRITEBYTECODE=1
CMD ["sh", "-c", "python3 -I /app/voice/fetch.py /models && exec python3 -m voice.server"]
