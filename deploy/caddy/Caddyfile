# The front door (S-199), on 127.0.0.1:${DESKTOP_PORT:-8080} (deploy/compose.yaml):
#   /mcp*        the kernel's MCP server (streamable HTTP); callers send their own bearer token (kk token ROLE)
#   /ui/*        the kernel's UI shell (its modules/ui, the kernel's D-44) and its view modules; / goes there
# The kernel sets the shell's own security headers (Content-Security-Policy, nosniff, no-referrer). Framed apps on
# their own origins come with the desktop (the next step): each gets a site block of its own here.
{
	admin off
	auto_https off
}

:8080 {
	encode zstd gzip

	redir / /ui/
	handle /mcp* {
		reverse_proxy kernel:8000
	}
	handle {
		reverse_proxy kernel:8000
	}
}
