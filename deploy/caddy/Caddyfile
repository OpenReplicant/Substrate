# The front door (S-199, S-200), on 127.0.0.1 only (deploy/compose.yaml publishes each port there):
#   :8080  the desktop: the kernel's UI shell at /ui/ (its D-44, D-127) and MCP at /mcp; /ui/apps.json, the framed apps
#          the shell lists (deploy/caddy/apps.json), is served from here, and the shell's own Content-Security-Policy
#          gains a frame-src naming exactly those apps' origins
#   :8081  Bifrost's dashboard (the gateway), framable by the desktop only
#   :8082  Substrate's map pages (ui/), framable by the desktop only
#   :8083  the MCP router (S-205): its MCP endpoint at /mcp for agents, and its page (waiting calls, the record, the
#          tools) as a desktop app; it sets its own frame-ancestors
# Each framed app is on an origin of its own: a frame on the shell's origin, allowed scripts and same-origin, could undo
# its sandbox and read the person's token. The apps' own headers are rewritten here, in the proxy, not in their code:
# only `frame-ancestors 'none'` becomes the desktop's origins, and Bifrost's X-Frame-Options (DENY, which a browser
# applies even beside frame-ancestors in some versions) is dropped; the rest of each policy is theirs, unchanged.
# Caddy's header_down replaces by an RE2 regular expression (caddyserver.com/docs/caddyfile/directives/reverse_proxy,
# read 2026-11-23); these patterns have no special characters, so they match literally.
{
	admin off
	auto_https off
}

:8080 {
	encode zstd gzip

	redir / /ui/
	handle /ui/apps.json {
		root * /etc/caddy
		rewrite * /apps.json
		header Content-Type application/json
		header X-Content-Type-Options nosniff
		file_server
	}
	handle /mcp* {
		reverse_proxy kernel:8000
	}
	handle {
		reverse_proxy kernel:8000 {
			header_down Content-Security-Policy "default-src 'self';" "default-src 'self'; frame-src http://127.0.0.1:8081 http://127.0.0.1:8082 http://127.0.0.1:8083;"
		}
	}
}

:8081 {
	encode zstd gzip
	reverse_proxy gateway:8080 {
		header_down -X-Frame-Options
		header_down Content-Security-Policy "frame-ancestors 'none'" "frame-ancestors http://127.0.0.1:8080 http://localhost:8080"
	}
}

:8082 {
	encode zstd gzip
	reverse_proxy ui:8100 {
		header_down Content-Security-Policy "frame-ancestors 'none'" "frame-ancestors http://127.0.0.1:8080 http://localhost:8080"
	}
}

:8083 {
	encode zstd gzip
	reverse_proxy mcp-router:8090 {
		flush_interval -1
	}
}
