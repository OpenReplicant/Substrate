# The front door (workbench/BRIEF.md section 7):
#   /api/*            PostgREST; the prefix is stripped, so /api/note is PostgREST's /note
#   /ui/*, /mcp*      kernel, parked until Workbench's W4 (repos/kernel/deploy/Caddyfile had only these)
#   /plugins/*/web/*  each installed plugin's browser files; nothing else in a plugin folder is served
#   everything else   Workbench's shell from workbench/web; / is index.html, a template that finds the plugins
# With KK_SITE set to a public host name, Caddy gets and renews a certificate, as in kernel's file.
{$KK_SITE::80} {
	encode zstd gzip

	redir /api /api/
	handle_path /api/* {
		reverse_proxy postgrest:3000
	}

	@kernel path /ui /ui/* /mcp /mcp/*
	handle @kernel {
		reverse_proxy kernel:8000
	}

	@pluginweb path_regexp ^/plugins/[a-z0-9_-]+/web/
	handle @pluginweb {
		root * /srv
		file_server
	}
	handle /plugins/* {
		respond 404
	}

	handle {
		root * /srv
		# Alpine's CSP build and vendored Dockview need nothing inline; apps on other origins go in {$WB_FRAME_SRC}
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-src 'self' {$WB_FRAME_SRC}; frame-ancestors 'self'; object-src 'none'; base-uri 'none'; form-action 'self'"
			X-Content-Type-Options nosniff
			Referrer-Policy same-origin
		}
		rewrite / /wb/index.html
		templates
		file_server
	}
}
