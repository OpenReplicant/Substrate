# The front door with plugins (S-20): Caddy built by xcaddy from the official builder image, with the modules in
# plugins.txt, then copied onto the official runtime image (the method in the image's own docs, "Adding custom
# Caddy modules"). scripts/build.sh caddy uses this only when plugins.txt lists a module.
ARG CADDY_VERSION=2.11.7

FROM docker.io/library/caddy:${CADDY_VERSION}-builder-alpine AS build
ARG CADDY_VERSION
COPY plugins.txt /plugins.txt
RUN set -- ; for p in $(grep -v '^[[:space:]]*#' /plugins.txt | awk '{print $1}'); do set -- "$@" --with "$p"; done; \
    xcaddy build "v${CADDY_VERSION}" "$@" --output /usr/bin/caddy && /usr/bin/caddy list-modules --versions | tail -n 20

FROM docker.io/library/caddy:${CADDY_VERSION}-alpine
COPY --from=build /usr/bin/caddy /usr/bin/caddy
