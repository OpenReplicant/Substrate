# substrate-worker (plan step 1, S-163): the offline agent. The Knowledge Kernel's image (python 3.13.16 on Alpine, pinned by
# digest in the kernel's Dockerfile; has kernel-mcp, mcp 2.3.0, psycopg) plus the pinned `openai` client. The loop itself
# is environment/worker.py, mounted read-only by compose. Build the kernel image first (scripts/build.sh kernel):
#   scripts/build.sh worker
ARG KERNEL_IMAGE=localhost/substrate-kernel:local
FROM ${KERNEL_IMAGE}
USER root
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir --no-deps -r /tmp/requirements.txt && rm /tmp/requirements.txt
RUN mkdir /workspace && chown nobody /workspace
USER nobody
WORKDIR /app
ENV PYTHONPATH=/app PYTHONDONTWRITEBYTECODE=1
