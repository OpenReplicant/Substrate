<?xml version="1.0" encoding="UTF-8"?>
<!-- A demo business's process (spec step 10, made up): Harbour Bakery's wholesale order, from a café's order to the
     bread delivered before 7am. business:bpmn reads it into the harbour-bakery domain; export-bpmn writes it back. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_wholesale" targetNamespace="https://example.org/harbour-bakery">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_bakery" name="Harbour Bakery" processRef="Process_wholesale" />
  </bpmn:collaboration>
  <bpmn:process id="Process_wholesale" name="Wholesale order" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_office" name="Office manager">
        <bpmn:flowNodeRef>StartEvent_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_take</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_time</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_late</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_add</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_head" name="Head baker">
        <bpmn:flowNodeRef>Activity_plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_bake</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_driver" name="Driver">
        <bpmn:flowNodeRef>Activity_deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_delivered</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:dataObject id="DataObject_orders" />
    <bpmn:dataObject id="DataObject_note" />
    <bpmn:startEvent id="StartEvent_order" name="Order arrives">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_order" />
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_take" name="Take the order">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_time" name="Before 4pm?" default="Flow_yes">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="Activity_late" name="Decide on a late order">
      <bpmn:incoming>Flow_no</bpmn:incoming>
      <bpmn:outgoing>Flow_late</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:userTask id="Activity_add" name="Add to tonight's order list">
      <bpmn:incoming>Flow_yes</bpmn:incoming>
      <bpmn:incoming>Flow_late</bpmn:incoming>
      <bpmn:outgoing>Flow_add</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_orders">
        <bpmn:targetRef>DataObjectReference_orders</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_plan" name="Plan the night's bake">
      <bpmn:incoming>Flow_add</bpmn:incoming>
      <bpmn:outgoing>Flow_plan</bpmn:outgoing>
      <bpmn:property id="Property_plan" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_orders">
        <bpmn:sourceRef>DataObjectReference_orders</bpmn:sourceRef>
        <bpmn:targetRef>Property_plan</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="Activity_bake" name="Bake">
      <bpmn:incoming>Flow_plan</bpmn:incoming>
      <bpmn:outgoing>Flow_bake</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Activity_deliver" name="Load the van and deliver">
      <bpmn:incoming>Flow_bake</bpmn:incoming>
      <bpmn:outgoing>Flow_end</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_note">
        <bpmn:targetRef>DataObjectReference_note</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:endEvent id="EndEvent_delivered" name="Delivered">
      <bpmn:incoming>Flow_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObjectReference id="DataObjectReference_orders" name="Night's order list" dataObjectRef="DataObject_orders" />
    <bpmn:dataObjectReference id="DataObjectReference_note" name="Delivery note" dataObjectRef="DataObject_note" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_order" targetRef="Activity_take" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_take" targetRef="Gateway_time" />
    <bpmn:sequenceFlow id="Flow_yes" name="yes" sourceRef="Gateway_time" targetRef="Activity_add" />
    <bpmn:sequenceFlow id="Flow_no" name="no" sourceRef="Gateway_time" targetRef="Activity_late">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">arrived after 4pm</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_late" name="accepted" sourceRef="Activity_late" targetRef="Activity_add" />
    <bpmn:sequenceFlow id="Flow_add" sourceRef="Activity_add" targetRef="Activity_plan" />
    <bpmn:sequenceFlow id="Flow_plan" sourceRef="Activity_plan" targetRef="Activity_bake" />
    <bpmn:sequenceFlow id="Flow_bake" sourceRef="Activity_bake" targetRef="Activity_deliver" />
    <bpmn:sequenceFlow id="Flow_end" sourceRef="Activity_deliver" targetRef="EndEvent_delivered" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_bakery_di" bpmnElement="Participant_bakery" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1250" height="530" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_office_di" bpmnElement="Lane_office" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1220" height="230" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_head_di" bpmnElement="Lane_head" isHorizontal="true">
        <dc:Bounds x="190" y="310" width="1220" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_driver_di" bpmnElement="Lane_driver" isHorizontal="true">
        <dc:Bounds x="190" y="460" width="1220" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_order_di" bpmnElement="StartEvent_order">
        <dc:Bounds x="232" y="137" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_take_di" bpmnElement="Activity_take">
        <dc:Bounds x="310" y="115" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_time_di" bpmnElement="Gateway_time">
        <dc:Bounds x="455" y="130" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_late_di" bpmnElement="Activity_late">
        <dc:Bounds x="540" y="205" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_add_di" bpmnElement="Activity_add">
        <dc:Bounds x="700" y="115" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_plan_di" bpmnElement="Activity_plan">
        <dc:Bounds x="860" y="345" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_bake_di" bpmnElement="Activity_bake">
        <dc:Bounds x="1010" y="345" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_deliver_di" bpmnElement="Activity_deliver">
        <dc:Bounds x="1160" y="495" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_delivered_di" bpmnElement="EndEvent_delivered">
        <dc:Bounds x="1312" y="517" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataObjectReference_orders_di" bpmnElement="DataObjectReference_orders">
        <dc:Bounds x="742" y="235" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataObjectReference_note_di" bpmnElement="DataObjectReference_note">
        <dc:Bounds x="1292" y="380" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="268" y="155" />
        <di:waypoint x="310" y="155" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="410" y="155" />
        <di:waypoint x="455" y="155" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_yes_di" bpmnElement="Flow_yes">
        <di:waypoint x="505" y="155" />
        <di:waypoint x="700" y="155" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_no_di" bpmnElement="Flow_no">
        <di:waypoint x="480" y="180" />
        <di:waypoint x="480" y="245" />
        <di:waypoint x="540" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_late_di" bpmnElement="Flow_late">
        <di:waypoint x="640" y="245" />
        <di:waypoint x="670" y="245" />
        <di:waypoint x="670" y="175" />
        <di:waypoint x="700" y="175" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_add_di" bpmnElement="Flow_add">
        <di:waypoint x="800" y="155" />
        <di:waypoint x="830" y="155" />
        <di:waypoint x="830" y="385" />
        <di:waypoint x="860" y="385" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_plan_di" bpmnElement="Flow_plan">
        <di:waypoint x="960" y="385" />
        <di:waypoint x="1010" y="385" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_bake_di" bpmnElement="Flow_bake">
        <di:waypoint x="1110" y="385" />
        <di:waypoint x="1135" y="385" />
        <di:waypoint x="1135" y="535" />
        <di:waypoint x="1160" y="535" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_end_di" bpmnElement="Flow_end">
        <di:waypoint x="1260" y="535" />
        <di:waypoint x="1312" y="535" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DataOutputAssociation_orders_di" bpmnElement="DataOutputAssociation_orders">
        <di:waypoint x="760" y="195" />
        <di:waypoint x="760" y="235" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DataInputAssociation_orders_di" bpmnElement="DataInputAssociation_orders">
        <di:waypoint x="778" y="260" />
        <di:waypoint x="860" y="365" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DataOutputAssociation_note_di" bpmnElement="DataOutputAssociation_note">
        <di:waypoint x="1240" y="495" />
        <di:waypoint x="1300" y="430" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
