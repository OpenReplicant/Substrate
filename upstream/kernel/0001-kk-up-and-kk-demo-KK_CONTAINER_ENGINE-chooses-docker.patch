From 6efaf0a392fccdea667f8617d596fbc8d3ff6030 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 6 Nov 2026 11:28:34 -0800
Subject: [PATCH] kk up and kk demo: KK_CONTAINER_ENGINE chooses docker or
 podman

The stack was started with docker hard-coded in three places (build, compose up,
compose run) plus kk demo's load step. KK_CONTAINER_ENGINE (default docker) now
names the engine; the compose file already works the same with Podman.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01KhsqyxKrPYXpuuRzazmnhP
---
 README.md  |  2 ++
 kk/demo.py |  2 +-
 kk/up.py   | 15 ++++++++++-----
 3 files changed, 13 insertions(+), 6 deletions(-)

diff --git a/README.md b/README.md
index ce84ea2..93370fe 100644
--- a/README.md
+++ b/README.md
@@ -41,6 +41,8 @@ Recalled for "which psycopg do we pin?" (who said it; belief 0-1; explain(#handl
 - knowledge-kernel · softwareRequirements · psycopg (version ==3.3.6) — repository encoder (agent); belief 0.90 #0c1d7e42
 ```
 
+With Podman instead of Docker, set `KK_CONTAINER_ENGINE=podman` before `kk up` or `kk demo`.
+
 `kk up` prints the UI address (http://127.0.0.1:8080/ui/) and your sign-in (name and password) for reviewing. Logins
 stay in `~/.config/knowledge-kernel`, never in the project; running it again changes nothing but what
 changed in the project (D-57). It reads the project's packages, dependencies and documents in (D-68,
diff --git a/kk/demo.py b/kk/demo.py
index 69e649e..520ba65 100644
--- a/kk/demo.py
+++ b/kk/demo.py
@@ -137,7 +137,7 @@ def main(argv: list[str]) -> None:
         os.environ["DATABASE_URL"] = out["admin_url"]
         loaded = load(bpi, a.agent)
     else:
-        cmd = ["docker", "compose", "-f", str(ROOT / "deploy/compose.yaml"), "--env-file", str(ROOT / "deploy/.env"),
+        cmd = [up.engine(), "compose", "-f", str(ROOT / "deploy/compose.yaml"), "--env-file", str(ROOT / "deploy/.env"),
                "run", "--rm", "--no-deps", "-T", "-v", "kk-artifacts:/artifacts", "-e", "KK_ARTIFACTS=/artifacts",
                *(["-v", f"{bpi.parent}:/data:ro"] if bpi else []),
                "kernel", "kk", "demo", "--agent", a.agent, *(["--bpi", "--load", f"/data/{bpi.name}"] if bpi else ["--load"])]
diff --git a/kk/up.py b/kk/up.py
index de46975..46145d3 100644
--- a/kk/up.py
+++ b/kk/up.py
@@ -64,6 +64,11 @@ def shown(path: Path) -> str:
 
 
 # ---------------------------------------------------------------- the stack
+def engine() -> str:
+    """The container engine that runs the stack: KK_CONTAINER_ENGINE, docker by default (podman works too)."""
+    return os.environ.get("KK_CONTAINER_ENGINE") or "docker"
+
+
 def stack(env_file: Path) -> tuple[str, str]:
     """Start the compose stack (secrets generated once); return the admin URL and the JWT secret."""
     env = read_env(env_file)
@@ -75,12 +80,12 @@ def stack(env_file: Path) -> tuple[str, str]:
                "KK_JWT_SECRET": env.get("KK_JWT_SECRET") or secrets.token_urlsafe(48),
                **({"KK_DB_PORT": os.environ["KK_DB_PORT"]} if os.environ.get("KK_DB_PORT") else {})}
         write_secret(env_file, env)
-    # Built every time: Docker's layer cache makes an unchanged checkout a no-op, and an updated one is
+    # Built every time: the engine's layer cache makes an unchanged checkout a no-op, and an updated one is
     # never run on an image of older code.
     ca = os.environ.get("KK_BUILD_CA")    # a TLS-intercepting proxy's CA, as a build secret
-    subprocess.run(["docker", "build", "-q", "-t", "knowledge-kernel:local",
+    subprocess.run([engine(), "build", "-q", "-t", "knowledge-kernel:local",
                     *(["--secret", f"id=ca,src={ca}"] if ca else []), str(ROOT)], check=True, stdout=subprocess.DEVNULL)
-    subprocess.run(["docker", "compose", "-f", str(ROOT / "deploy/compose.yaml"), "--env-file", str(env_file),
+    subprocess.run([engine(), "compose", "-f", str(ROOT / "deploy/compose.yaml"), "--env-file", str(env_file),
                     "up", "-d", "--wait", "db", "kernel", "caddy"], check=True, stdout=subprocess.DEVNULL)
     port = os.environ.get("KK_DB_PORT") or env.get("KK_DB_PORT") or "5432"
     return f"postgresql://postgres:{env['POSTGRES_PASSWORD']}@127.0.0.1:{port}/kk", env["KK_JWT_SECRET"]
@@ -97,7 +102,7 @@ def ready(url: str, timeout: float = 120) -> None:
             return
         except OSError:
             if time.time() > deadline:
-                sys.exit(f"the kernel did not answer at {url}: docker compose -f deploy/compose.yaml logs kernel")
+                sys.exit(f"the kernel did not answer at {url}: {engine()} compose -f deploy/compose.yaml logs kernel")
             time.sleep(1)
 
 
@@ -133,7 +138,7 @@ def encode(folder: Path, admin_url: str, env_file: Path | None) -> dict:
     from self_encoder.repo import commit
     args = ["--name", folder.name] + (["--commit", c] if (c := commit(folder)) else [])
     if env_file:   # the stack: the kernel image, the project read-only, artifacts in their volume
-        cmd = ["docker", "compose", "-f", str(ROOT / "deploy/compose.yaml"), "--env-file", str(env_file), "run",
+        cmd = [engine(), "compose", "-f", str(ROOT / "deploy/compose.yaml"), "--env-file", str(env_file), "run",
                "--rm", "--no-deps", "-v", f"{folder}:/repo:ro", "-v", "kk-artifacts:/artifacts",
                "-e", "KK_ARTIFACTS=/artifacts", "-e", "KK_ROLE=kkm_self_encoder",
                "kernel", "kk", "scan", "--repo", "/repo", *args]
