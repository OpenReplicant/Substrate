{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/spec.py\" hook",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*morphogen.*",
        "hooks": [
          {
            "type": "command",
            "async": true,
            "timeout": 120,
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/verdicts.sh\" --hook"
          }
        ]
      }
    ]
  }
}
